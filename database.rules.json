{
  "rules": {
    ".read": false,
    ".write": false,
    "quietRooms": {
      "$roomId": {
        "meta": {
          ".read": "auth != null && (!data.exists() || (data.child('expiresAt').isNumber() && data.child('expiresAt').val() > now))",
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "$roomId.matches(/^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$/) && newData.hasChildren(['createdAt', 'expiresAt', 'passageIndex', 'schemaVersion'])",
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 14400000"
          },
          "passageIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
          },
          "schemaVersion": {
            ".validate": "newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "auth != null && root.child('quietRooms').child($roomId).child('meta').child('expiresAt').val() > now",
          "$slot": {
            ".write": "auth != null && ($slot === 'one' || $slot === 'two') && root.child('quietRooms').child($roomId).child('meta').child('expiresAt').val() > now && root.child('quietRooms').child($roomId).child('claims').child($slot).child('uid').val() === auth.uid",
            ".validate": "!newData.exists() || newData.hasChildren(['progress', 'complete', 'lastSeen', 'joinedAt', 'schemaVersion'])",
            "progress": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "complete": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber() && newData.val() >= now - 3600000 && newData.val() <= now + 300000"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "schemaVersion": {
              ".validate": "newData.val() === 1"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "claims": {
          "$slot": {
            ".read": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".write": "auth != null && ($slot === 'one' || $slot === 'two') && root.child('quietRooms').child($roomId).child('meta').child('expiresAt').val() > now && ((!newData.exists() && data.exists() && data.child('uid').val() === auth.uid) || (newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || (data.child('uid').val() === auth.uid && newData.child('clientId').val() === data.child('clientId').val()) || !root.child('quietRooms').child($roomId).child('members').child($slot).child('lastSeen').isNumber() || root.child('quietRooms').child($roomId).child('members').child($slot).child('lastSeen').val() < now - 24000)))",
            ".validate": "!newData.exists() || newData.hasChildren(['uid', 'clientId'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "clientId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{12,64}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
